# Copy to .env in this directory. Never commit the populated file.
DATABASE_URL=postgresql://jobnester:jobnester_local_only@localhost:5433/jobnester
REDIS_URL=redis://localhost:6380
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
PUBLIC_PORTFOLIO_ORIGINS=http://localhost:3000
OWNER_EMAIL=
# Generate with: openssl rand -hex 32
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AI_SERVICE_URL=http://localhost:8000
# Shared service credential; generated by npm start/setup.
AI_SERVICE_TOKEN=
# Only the Python AI container receives the provider key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Legacy aliases kept empty; Gemini is the supported provider.
OPENAI_API_KEY=
OPENAI_MODEL=
# This URL is embedded at frontend build time. Leave unset for browser-local demo.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional contact notification email. Requires a verified sending domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFY_EMAIL=
# Set only behind one trusted reverse proxy.
TRUST_PROXY=0
# Optional private portfolio media bucket. Keep the bucket private.
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for an S3-compatible service; leave empty for AWS S3.
S3_ENDPOINT=
# Optional: approved LinkedIn "Sign In with LinkedIn using OpenID Connect" product.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Clerk replaces Auth.js for owner login. Use the same Clerk application for web and API.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional offline JWT verification key, and stable owner ID (alternative to verified OWNER_EMAIL).
CLERK_JWT_KEY=
CLERK_OWNER_USER_ID=
# Local durable media is the default; switch to s3 to use your configured bucket.
ASSET_STORAGE=local
UPLOAD_DIRECTORY=/data/uploads
# Optional SMTP alternative to Resend for full contact inquiry delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
