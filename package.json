{
  "name": "jobnester",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/services.mjs start",
    "start:docker": "node scripts/services.mjs start",
    "start:live": "node scripts/services.mjs start",
    "docker:up": "node scripts/services.mjs start",
    "docker:down": "node scripts/services.mjs stop",
    "docker:restart": "node scripts/services.mjs restart",
    "docker:status": "node scripts/services.mjs status",
    "docker:logs": "node scripts/services.mjs logs",
    "docker:setup": "node scripts/services.mjs config",
    "dev": "node scripts/services.mjs start",
    "build": "npm run build -w @jobnester/web && npm run build -w @jobnester/api && npm run build -w @jobnester/worker",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p apps/worker && tsc --noEmit -p apps/web",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "node --import tsx prisma/seed.ts",
    "test:integration": "RUN_INTEGRATION=1 node --import tsx --test tests/integration.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages tests docs scripts *.json *.md *.yaml .github/workflows/*.yml",
    "stop": "node scripts/services.mjs stop",
    "restart": "node scripts/services.mjs restart",
    "status": "node scripts/services.mjs status",
    "logs": "node scripts/services.mjs logs",
    "setup": "node scripts/services.mjs config",
    "start:web": "npm run start -w @jobnester/web",
    "build:site": "node scripts/export-site.mjs",
    "test:ai": "docker compose exec -T ai python -m unittest discover -s tests -v",
    "dev:web": "npm run dev -w @jobnester/web",
    "dev:demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.10.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "postcss": "^8.5.33"
  },
  "type": "module",
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "^8.0.2"
  }
}
